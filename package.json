{
  "name": "voxel-planet",
  "version": "1.0.0",
  "description": "First-person procedural voxel planet wilderness explorer.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5161 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 5161",
    "check": "node scripts/check-controls.ts && node scripts/check-tiers.ts",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"scripts/**/*.ts\" vite.config.ts index.html"
  },
  "dependencies": {
    "nipplejs": "^1.0.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
